      "defaults": [
        {
          "title": "Bonus up to 20,000 AZN + 35 AZN Free Bet"
        }
      ]
    },
    {
      "key": "after_offer",
      "label": "Text after the offers",
      "addLabel": "Add text",
      "itemLabel": "Text",
      "min": 0,
      "max": 5,
      "after": "button_link",
      "fields": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "default": ""
        }
      ],
      "defaults": [
        {
          "text": "One more part of your welcome is ready to keep the Sportsbook experience going."
        },
        {
          "text": "Casino gives you another option at this stage: Bonus up to 20,000 AZN + 185 Free Spins."
