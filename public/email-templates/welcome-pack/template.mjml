<mjml>
    <mj-head>
        <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" />

        <mj-attributes>
            <mj-all font-family="Arial, sans-serif" />
            <mj-text color="#ffffff" font-size="14px" line-height="22px" />
        </mj-attributes>

        <mj-style inline="inline">
            .footer-link { color: #cfb06e !important; text-decoration: underline; }
            .fixed-35 {
                width: 35px !important;
                max-width: 35px !important;
            }
            .fixed-badge {
                width: 120px !important;
                max-width: 120px !important;
            }
        </mj-style>
        <mj-style>
            .age {
                width: 60px !important;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#111111">

        <!-- Глобальний wrapper із фоновим паттерном на всю ширину екрану -->
        <mj-wrapper background-url="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KS59FC75YNCAPQGSQEQB864S.png" background-repeat="repeat" full-width="full-width" padding="24px 0 24px">

            <!-- ХЕДЕР: Верхня частина золотої рамки -->
            <mj-section background-color="#0A0A0A" border-top="1px solid #C9A84C" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="30px 25px">
                <mj-group>
                    <mj-column width="50%" vertical-align="middle" css-class="fixed-203">
                        <mj-image src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KRWYBH71X57H0TAFHMCC55N9.png" alt="ROYALÉ" padding="0" width="203px" align="left" href="[[logo_url]]"/>
                    </mj-column>
                    <mj-column vertical-align="middle" css-class="button">
                        <mj-button background-color="#C9A84C" color="#0A0A0A" font-weight="700" font-size="11px" border-radius="4px" href="[[header_button_url]]" align="right" padding="0" height="30px" inner-padding="0 15px" letter-spacing="1px" text-transform="uppercase">
                            [[header_button_text]]
                        </mj-button>
                    </mj-column>
                </mj-group>
            </mj-section>

            <!-- ГОЛОВНИЙ БАНЕР -->
            <mj-section background-color="#0A0A0A" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="0 25px 35px 25px">
                <mj-column>
                    <mj-image src="[[banner_image]]" alt="Casino Bonus Hero" padding="0" border-radius="4px" href="[[banner_url]]"/>
                </mj-column>
            </mj-section>

            <mj-section background-color="#0A0A0A" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="0 25px 0 25px">
                <mj-column padding="0">
                    <mj-text padding="0" align="center" color="#C9A84C" text-transform="uppercase" line-height="1.1">
                        <h1>
                            [[main_title]]
                        </h1>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- ТЕКСТОВИЙ БЛОК -->
            <mj-section background-color="#0A0A0A" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="0 25px 25px 25px">
                <mj-column padding="0" width="100%">
                    <mj-text align="center" font-size="14px" line-height="22px" color="#cccccc" padding="0 0 15px 0">
                        {{snippets.greetings_en}} [[intro_text]]
                    </mj-text>

                    <!-- repeat:after_greeting -->
                    <mj-text align="center" font-size="14px" line-height="22px" color="#cccccc" padding="0 0 15px 0">
                        [[text]]
                    </mj-text>
                    <!-- /repeat -->
                </mj-column>

                <!-- БОНУС-БЛОКИ: скільки їх буде, вирішує форма (кнопка «Add bonus block») -->
                <!-- repeat:bonuses -->
                <mj-column background-color="#222121" padding="0 0 0 0" width="100%">
                    <mj-text align="center" font-size="14px">
                        <span style="color: #C9A84C; font-weight: 700;display: block;max-width: 200px;margin: 0 auto;">[[title]]</span>
                        Deposit from <span style="font-weight: 700">[[deposit]]</span>
                    </mj-text>
                </mj-column>
                <!-- separator -->
                <mj-column>
                    <mj-spacer height="10px" />
                </mj-column>
                <!-- /repeat -->

                <mj-column padding="0" width="100%">
                    <!-- repeat:summary -->
                    <mj-text align="center" font-size="14px" color="#cccccc" padding="15px 0 0 0">
                        [[text]]
                    </mj-text>
                    <!-- /repeat -->
                    <mj-text align="center" font-size="14px" color="#cccccc" padding="15px 0 0 0">
                        [[closing_text]]
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- КНОПКА ТА ПІДПИС -->
            <mj-section background-color="#0A0A0A" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="0 25px 25px 25px">
                <mj-column padding="0">
                    <mj-button background-color="#C9A84C" color="#0A0A0A" font-weight="700" font-size="16px" border-radius="4px" href="[[button_link]]" inner-padding="14px 40px" letter-spacing="1px" padding="0" text-transform="uppercase">
                        [[button_text]]
                    </mj-button>
                </mj-column>
            </mj-section>

            <!-- СОЦМЕРЕЖІ ТА ПІДТРИМКА -->
            <mj-section background-color="#0A0A0A" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="0 25px 25px 32px">
                <mj-column>
                    <mj-divider border-width="1px" border-color="#222222" padding="0 0 15px 0" />
                    <mj-social font-size="15px" icon-size="36px" mode="horizontal" padding="0 0 15px 0">
                        <mj-social-element src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZE7EK8TTJB9AQZ0WMEQXMN8.png" border-radius="20px" href="[[tik_tok]]" padding="0 15px 0 0"/>
                        <mj-social-element src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZE7EK8V3V014CBVC9XTC562.png" border-radius="20px" href="[[inst]]" padding="0 15px 0 0"/>
                        <mj-social-element src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZE7EK8W8C35QHBE0PMH8E8F.png" border-radius="20px" href="[[face_book]]" padding="0 15px 0 0"/>
                        <mj-social-element src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZE7EK8VK9MYM4TF8MJ5SYDH.png" border-radius="20px" href="[[telegram]]" padding="0 15px 0 0"/>
                        <mj-social-element src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZE7EK8XQXTV18DBDJ841FS9.png" border-radius="20px" href="[[whatsup]]" />
                    </mj-social>
                    <mj-divider border-width="1px" border-color="#222222" padding="0 0 32px 0" />
                    <mj-text font-size="12px" color="#ffffff" line-height="18px" padding="0 0 0 0">
                        Our support team is here for you, around the clock: <a href="mailto:[[support_email]]" class="footer-link">[[support_email]]</a>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- ФУТЕР: Нижня частина золотої рамки -->
            <mj-section background-color="#0A0A0A" border-bottom="1px solid #C9A84C" border-left="1px solid #C9A84C" border-right="1px solid #C9A84C" padding="9px 25px 5px 25px">
                <mj-group width="100%">
                    <mj-column padding="0" width="35px" mj-class="age" css-class="fixed-35">
                        <mj-image src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZEA2YTHGBYNCSQMYM7TF082.png" width="28px" height="29px" align="left" padding="0"/>
                    </mj-column>
                    <mj-column padding="0" width="255px" css-class="fixed-badge">
                        <mj-image src="https://userimg-assets-eu.customeriomail.com/images/client-env-216192/01KZEA2YTFG9RV5TDHGZQTP96G.png" width="114px" height="30px" align="left" padding="0"/>
                    </mj-column>
                </mj-group>
                <mj-column width="100%" padding="10px 0 16px 0">
                    <mj-text font-size="10px" color="#555555" line-height="16px" padding="0 0 12px">
                        [[legal_text]]
                    </mj-text>
                    <mj-text color="#555555" padding="0" font-size="10px">
                        <a href="%%unsub_url%%" style="color: #555555; text-decoration: underline;">
                            Unsubscribe
                        </a>
                    </mj-text>

                </mj-column>
            </mj-section>

        </mj-wrapper>
    </mj-body>
</mjml>
