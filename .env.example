# Copy this file to .env and fill in the real values. .env is gitignored -
# never commit real endpoint/webhook values (see the security note in
# scripts/generate-env.js and README if one exists).

# Backend API base URL, no trailing slash.
API_BASE_URL=http://localhost:3000

# n8n webhook that runs a newly created job (JobsService.createJob).
# Treat this URL as a secret: anyone who has it can trigger the workflow
# directly, without going through this app or its backend at all.
N8N_WEBHOOK_URL=


TEST_N8N_WEBHOOK_URL=

# n8n webhooks that run a newly created SEO job (SeoJobsService.createJob),
# and the test one used when the "testing" toggle is on. Same secrecy rules
# as above. Optional: if blank, the SEO job record is still created but
# nothing is triggered in n8n, and the user gets an error message.
SEO_N8N_WEBHOOK_URL=
TEST_SEO_N8N_WEBHOOK_URL=

# n8n webhooks that run a newly created design job
# (DesignJobsService.createJob), and the test one used when the "testing"
# toggle is on. Same secrecy rules as above. Optional: if blank, the job
# record is still created but nothing is triggered in n8n, and the user
# gets an error message.
BANNERS_N8N_WEBHOOK_URL=
BANNERS_TEST_N8N_WEBHOOK_URL=

WELCOME_EMAIL_HTML_UPDATE=
TEST_WELCOME_EMAIL_HTML_UPDATE=

SYSTEM_EMAIL_HTML_UPDATE=
TEST_SYSTEM_EMAIL_HTML_UPDATE=
